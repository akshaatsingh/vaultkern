PORT=3001
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://vaultkern:vaultkern_secret@localhost:5432/vaultkern_db
REDIS_URL=redis://localhost:6379
ADMIN_API_KEY=vaultkern_admin_secret_key_2026

# Optional Gmail / SMTP Credentials for live delivery of verification OTPs
# If left unset, Vaultkern runs in mock/dev mode, logging the OTP directly to console and returning in test response
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM="Vaultkern Security" <security@vaultkern.io>
