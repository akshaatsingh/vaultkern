{
  "name": "vaultkern",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-Grade Double-Entry Digital Wallet & Payment Ledger API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts",
    "demo": "tsx src/demo.ts"
  },
  "keywords": [
    "fintech",
    "double-entry",
    "ledger",
    "wallet",
    "idempotency",
    "postgres",
    "redis"
  ],
  "author": "akshaatsingh",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "puppeteer-core": "^25.18.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
